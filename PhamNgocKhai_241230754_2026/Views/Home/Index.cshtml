@{
    ViewData["Title"] = "Home Page";
}

<div id="maincontent">
    <partial name="PhamNgocKhai_MainContent" />
</div>


@section Scripts {
    <script>
        $(document).on('click', '.loc-the-loai', function (e) {
            e.preventDefault();

            var theloai = $(this).data("id");

            $.ajax({
                url: '@Url.Action("LocTheLoai", "Home")',
                type: 'GET',
                data: { Matl: theloai },

                success: function (result) {
                    $("#maincontent").html(result);

                },

                error: function (error) {
                    console.log(error);
                }
            })
        });
    </script>
}